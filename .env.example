# ####################################################################
# Koge-Kanban Configuration Example
# Copy this file to '.env' and fill in your values.
# ####################################################################

# --- DATABASE ---
# Relative path to the SQLite database file
DB_PATH=db/kanban.db

# --- SERVER ---
PORT=3000
NODE_ENV=production

# --- SECURITY ---
# IMPORTANT: Use a strong, unique secret key.
# Recommended: Generate a 64-character hex string.
JWT_SECRET=replace_this_with_a_secure_random_string

# Comma-separated list of frontends allowed to connect to this API.
# Example: https://koge.example.com,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- WEBSOCKET ---
# Set to 'false' to disable real-time features.
ENABLE_WEBSOCKET=true

# --- AI (OLLAMA) ---
# The URL where your Ollama API is accessible.
# If running on the same server: http://127.0.0.1:11434
# If using a tunnel or remote: https://ollama.example.com
OLLAMA_HOST=http://127.0.0.1:11434
