# --- DATABASE CONFIGURATION ---
# Path to your SQLite database file.
# Default is db/kanban.db (relative to project root)
DB_PATH=db/kanban.db

# --- SERVER CONFIGURATION ---
# Port the backend server will listen on
PORT=3000
# Set to 'production' when deploying
NODE_ENV=development

# --- SECURITY ---
# CRITICAL: Change this to a long, random secret key for production!
# You can generate one using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" / DevToys>Generator>UUID / Password Gnerator
JWT_SECRET=

# --- AI CONFIGURATION (OLLAMA) ---
# Comma-separated list of Ollama host endpoints.
# Local default: http://127.0.0.1:11434
OLLAMA_HOST=http://127.0.0.1:11434
